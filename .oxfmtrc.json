{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "printWidth": 120,
    "sortPackageJson": false,
    "ignorePatterns": [
        "pnpm-lock.yaml",
        ".release-please-manifest.json",
        ".next/",
        ".vercel/",
        ".next-admin/",
        "test-results/",
        "tsconfig.tsbuildinfo"
    ],
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
