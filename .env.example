# Content: "fixtures" (default) reads tests/fixtures/content; "db" reads the Neon database.
CONTENT_SOURCE=
# Neon Postgres (added by the Vercel Neon integration). Needed for CONTENT_SOURCE=db, db:migrate and db:seed.
DATABASE_URL=
# Vercel Blob (added by the Vercel Blob integration). Needed for resume and photo uploads.
BLOB_READ_WRITE_TOKEN=

# Admin sign-in (Auth.js with a GitHub OAuth app). ADMIN_GITHUB_ID is the numeric id of the one allowed account.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_ID=

# Spotify "now playing" (optional: without these the music card shows "not listening right now").
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Comma-separated words that must never appear in the built site (the stealth company's name and details).
# Set this locally and in CI; never commit real values.
STEALTH_TERMS=
