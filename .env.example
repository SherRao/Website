# Content: "fixtures" (default) reads src/content/seed; "db" reads the Neon database.
CONTENT_SOURCE=
# Neon Postgres (added by the Vercel Neon integration). Needed for CONTENT_SOURCE=db, db:migrate and db:seed.
DATABASE_URL=
# Vercel Blob (added by the Vercel Blob integration). Needed for resume and photo uploads.
BLOB_READ_WRITE_TOKEN=

# Admin sign-in (Auth.js with a GitHub OAuth app). ADMIN_GITHUB_ID is the numeric id of the one allowed account.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_ID=

# Content API for the admin app (/api/admin/v1). Comma-separated secrets: a request signed with any of them is
# accepted, so a secret can be rotated without downtime (see the README). Make one with `openssl rand -hex 32`.
# Locally, use the same value as the admin app's secret for this site. Unset, every API request is refused.
ADMIN_API_SECRETS=

# Spotify "now playing" (optional: without these the music card shows "not listening right now").
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
