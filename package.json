{
    "name": "website-v5",
    "version": "0.6.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build && node scripts/stealth-scan.mjs",
        "start": "next start",
        "lint": "oxlint --deny-warnings",
        "format": "oxfmt src tests scripts \"*.{ts,mjs}\"",
        "format:check": "oxfmt --check src tests scripts \"*.{ts,mjs}\"",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs}": [
            "oxfmt --no-error-on-unmatched-pattern",
            "oxlint --fix"
        ],
        "*.{json,md,css,yml,yaml}": [
            "oxfmt --no-error-on-unmatched-pattern"
        ]
    },
    "dependencies": {
        "fast-xml-parser": "^5.11.2",
        "lenis": "^1.3.27",
        "next": "^16.4.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    }
}
