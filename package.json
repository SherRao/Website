{
  "name": "website-v5",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/stealth-scan.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write src tests scripts \"*.{ts,mjs}\"",
    "format:check": "prettier --check src tests scripts \"*.{ts,mjs}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed-content.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "next": "^16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
